[Icon Theme]
Name=Kiwori Dark
Comment=A colorful and playful icon theme for Linux desktops (Dark mode fallback)
Inherits=breeze-dark,hicolor
Example=folder

Directories=scalable/apps,scalable/actions,scalable/devices,scalable/places,scalable/mimetypes,scalable/categories,scalable/status,scalable/emblems

[scalable/apps]
Size=256
Context=Applications
Type=Scalable
MinSize=16
MaxSize=512

[scalable/actions]
Size=256
Context=Actions
Type=Scalable
MinSize=16
MaxSize=512

[scalable/devices]
