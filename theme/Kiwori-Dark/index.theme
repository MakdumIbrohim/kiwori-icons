MinSize=16
MaxSize=512

[scalable/mimetypes]
Size=256
Context=MimeTypes
Type=Scalable
MinSize=16
MaxSize=512

[scalable/categories]
Size=256
Context=Categories
Type=Scalable
MinSize=16
MaxSize=512

[scalable/status]
Size=256
Context=Status
Type=Scalable
MinSize=16
MaxSize=512

